&control
  calculation='scf', prefix='pbe_c30', outdir='./tmp_pbe_c30', pseudo_dir='/path/to/scn_fet/pseudo',
  verbosity='high', max_seconds=80000
/
&system
  ibrav=6, celldm(1)=5.8757877319, celldm(3)=9.6483716440, nat=4, ntyp=2,
  ecutwfc=80, ecutrho=320,
  occupations='smearing', smearing='mv', degauss=0.005, nbnd=24
/
&electrons
  conv_thr=1.0d-10, mixing_beta=0.4
/
ATOMIC_SPECIES
  Sc 44.955908 Sc_ONCV_PBE-1.0.oncvpsp.upf
  N  14.007 N.oncvpsp.upf
ATOMIC_POSITIONS crystal
  Sc 0.0 0.0 0.4638713145
  N  0.5 0.5 0.4638213240
  N  0.0 0.0 0.5361786760
  Sc 0.5 0.5 0.5361286855
K_POINTS automatic
  12 12 1 0 0 0
