&control
  calculation='scf', prefix='hse_fock320', outdir='./tmp_hse_fock320', pseudo_dir='/path/to/scn_fet/pseudo',
  verbosity='high', max_seconds=80000
/
&system
  ibrav=2, celldm(1)=8.5056572869, nat=2, ntyp=2,
  ecutwfc=80, ecutrho=320,
  occupations='fixed', nbnd=12,
  input_dft='hse', nqx1=4, nqx2=4, nqx3=4, ecutfock=320
/
&electrons
  conv_thr=1.0d-9, mixing_beta=0.5
/
ATOMIC_SPECIES
  Sc 44.955908 Sc_ONCV_PBE-1.0.oncvpsp.upf
  N  14.007 N.oncvpsp.upf
ATOMIC_POSITIONS crystal
  Sc 0.0 0.0 0.0
  N  0.5 0.5 0.5
K_POINTS automatic
  8 8 8 0 0 0
