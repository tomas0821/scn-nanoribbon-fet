&control
  calculation='bands', prefix='pbe_scf', outdir='./tmp_pbe_scf', pseudo_dir='/path/to/scn_fet/pseudo',
  verbosity='high', max_seconds=80000
/
&system
  ibrav=2, celldm(1)=8.5056572869, nat=2, ntyp=2,
  ecutwfc=80, ecutrho=320,
  occupations='smearing', smearing='mv', degauss=0.01, nbnd=30
/
&electrons
  conv_thr=1.0d-10, mixing_beta=0.5, diago_full_acc=.true.
/
ATOMIC_SPECIES
  Sc 44.955908 Sc_ONCV_PBE-1.0.oncvpsp.upf
  N  14.007 N.oncvpsp.upf
ATOMIC_POSITIONS crystal
  Sc 0.0 0.0 0.0
  N  0.5 0.5 0.5
K_POINTS tpiba_b
  6
  0.5000 0.5000 0.5000 40
  0.0000 0.0000 0.0000 40
  0.0000 0.0000 1.0000 40
  0.5000 0.0000 1.0000 40
  0.7500 0.0000 0.7500 40
  0.0000 0.0000 0.0000 1
